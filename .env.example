# Copy to .env and edit. `docker compose up -d service` reads it automatically.
# Assignment 2 runs one configuration at a time; nothing else changes between runs.

# --- single model (Assignment 1 behaviour) ---
MODE=single
MODEL=qwen2.5:7b

# --- cascade (Assignment 2): comment out the two lines above and use these ---
# MODE=cascade
# SMALL_MODEL=phi4-mini
# LARGE_MODEL=qwen2.5:7b
# CASCADE_SETTING=1          # 1 = escalate Bank account; 2 = + Consumer loan (docs/escalation_rule.md)

NUM_CTX=2048                 # fixed for A2: changing it makes Ollama reload the model
